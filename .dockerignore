# ==========================================
# Git & Version Control
# ==========================================
.git
.gitignore
.gitattributes

# ==========================================
# Python & Bytecode Cache
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so

# ==========================================
# Virtual Environments
# ==========================================
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ==========================================
# Environment Variables & Secrets (CRITICAL)
# ==========================================
.env
.env.*
!.env.example

# ==========================================
# Django Local Storage & Databases
# ==========================================
*.sqlite3
*.sqlite3-journal
db.sqlite3
/media/
/staticfiles/

# ==========================================
# IDEs & Code Editors
# ==========================================
.vscode/
.idea/
*.swp
*.swo

# ==========================================
# Docker Files (Avoid recursive copying)
# ==========================================
Dockerfile
docker-compose*.yml
.dockerignore
.devcontainer/

# ==========================================
# Testing & Coverage Reports
# ==========================================
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ==========================================
# Node / Frontend Build tools (If using Tailwind/React)
# ==========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*